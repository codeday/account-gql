    "@types/auth0": "^2.34.17",
    "@types/graphql-upload": "^8.0.11",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/lru-cache": "^7.6.1",
    "@types/node": "^20.17.19",
    "@types/node-fetch": "^2.5.7",
    "@types/validator": "^13.7.2",
    "@types/ws": "^8.5.3",
    "eslint": "^7.6.0",
