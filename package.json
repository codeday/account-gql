    "class-validator": "^0.14.1",
    "dotenv": "^16.0.0",
    "emoji-strip": "^1.0.1",
    "express": "^4.17.3",
    "graphql": "^16.11.0",
    "graphql-scalars": "^1.25.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-upload": "^13.0.0",
